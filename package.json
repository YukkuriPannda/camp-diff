{
  "name": "camp-diff",
  "displayName": "camp-diff",
  "description": "チームメンバーの編集箇所をリアルタイムに共有し、変更の衝突に早く気づけるようにするVS Code拡張",
  "keywords": [
    "collaboration",
    "presence",
    "git",
    "merge conflict",
    "realtime",
    "team"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/YukkuriPannda/camp-diff.git"
  },
  "bugs": {
    "url": "https://github.com/YukkuriPannda/camp-diff/issues"
  },
  "homepage": "https://github.com/YukkuriPannda/camp-diff#readme",
  "version": "0.0.2",
  "publisher": "camp-diff",
  "private": true,
  "workspaces": [
    "signaling-server"
  ],
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Other"
  ],
  "icon": "media/icon.png",
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "campDiff",
          "title": "camp-diff",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "campDiff": [
        {
          "id": "campDiff.mainView",
          "name": "camp-diff"
        }
      ]
    },
    "commands": [
      {
        "command": "campDiff.setUsername",
        "title": "camp-diff: Set Username"
      },
      {
        "command": "campDiff.refresh",
        "title": "camp-diff: Refresh Changed Ranges"
      }
    ],
    "configuration": {
      "title": "camp-diff",
      "properties": {
        "campDiff.username": {
          "type": "string",
          "default": "",
          "description": "他のメンバーに表示されるユーザー名。未設定の場合はgit config user.name、OSのユーザー名の順に自動解決します。"
        },
        "campDiff.diffBase": {
          "type": "string",
          "enum": [
            "head",
            "upstream"
          ],
          "enumDescriptions": [
            "HEADとの差分を共有します。ローカルでコミット済みの変更は含まれません。",
            "リモート追跡ブランチとの分岐点からの差分を共有します。未pushのコミットも含まれます。"
          ],
          "default": "head",
          "description": "編集中の行範囲を求めるときの比較対象です。"
        },
        "campDiff.conflictProximityLines": {
          "type": "number",
          "default": 3,
          "minimum": 0,
          "description": "変更範囲が重なっていなくても衝突の可能性ありとみなす、範囲間の最大行数です。"
        },
        "campDiff.remoteName": {
          "type": "string",
          "default": "origin",
          "description": "room keyの導出に使うGit remote名です。fork構成ではupstreamなどに変更できます。"
        },
        "campDiff.signalingServerUrls": {
          "type": "array",
          "default": [
            "ws://localhost:4444"
          ],
          "items": {
            "type": "string",
            "pattern": "^wss?://"
          },
          "description": "camp-diffのpresence中継に使うWebSocketサーバーURLです。"
        },
        "campDiff.roomPassword": {
          "type": "string",
          "default": "",
          "description": "presenceを中継前にAES-256-GCMで暗号化する任意のパスワードです。チーム全員で同じ値を設定します。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "compile": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src test",
    "test:compile": "tsc -p tsconfig.test.json",
    "test": "npm run test:compile && vscode-test",
    "test:integration": "npm run build && npm run test:compile && node ./out/test/extension/runTest.js",
    "test:package": "npm run build && npm run test:compile && node ./out/test/package/runPackageTest.js",
    "dev:signaling": "npm --prefix signaling-server run dev",
    "package": "vsce package"
  },
  "dependencies": {
    "ignore": "^7.0.8",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.4.0",
    "@types/vscode": "^1.134.0",
    "@types/ws": "^8.18.1",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "mocha": "^11.8.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  }
}
