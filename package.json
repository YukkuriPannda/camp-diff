{
  "name": "camp-diff",
  "displayName": "camp-diff",
  "description": "チームメンバーの編集箇所をリアルタイムに共有し、変更の衝突に早く気づけるようにするVS Code拡張",
  "version": "0.0.1",
  "publisher": "camp-diff",
  "private": true,
  "workspaces": [
    "signaling-server"
  ],
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "campDiff",
          "title": "camp-diff",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "campDiff": [
        {
          "id": "campDiff.mainView",
          "name": "camp-diff"
        }
      ]
    },
    "commands": [
      {
        "command": "campDiff.setUsername",
        "title": "camp-diff: Set Username"
      }
    ],
    "configuration": {
      "title": "camp-diff",
      "properties": {
        "campDiff.username": {
          "type": "string",
          "default": "",
          "description": "他のメンバーに表示されるユーザー名。未設定の場合はgit config user.name、OSのユーザー名の順に自動解決します。"
        },
        "campDiff.cursorContextLines": {
          "type": "number",
          "default": 3,
          "minimum": 0,
          "description": "選択範囲が空のとき、カーソル行の前後何行を編集中の範囲として共有するか。"
        },
        "campDiff.idleTimeoutSeconds": {
          "type": "number",
          "default": 120,
          "minimum": 5,
          "description": "この秒数だけ編集操作がない場合、自分の編集箇所をほかのメンバーから見えなくします。"
        },
        "campDiff.conflictProximityLines": {
          "type": "number",
          "default": 3,
          "minimum": 0,
          "description": "編集範囲が重なっていなくても衝突の可能性ありとみなす、範囲間の最大行数です。"
        },
        "campDiff.signalingServerUrls": {
          "type": "array",
          "default": [
            "ws://localhost:4444"
          ],
          "items": {
            "type": "string",
            "pattern": "^wss?://"
          },
          "description": "WebRTC接続の確立に使うシグナリングサーバーURLです。"
        },
        "campDiff.iceServers": {
          "type": "array",
          "default": [
            {
              "urls": "stun:stun.l.google.com:19302"
            }
          ],
          "items": {
            "type": "object",
            "required": [
              "urls"
            ],
            "properties": {
              "urls": {
                "type": [
                  "string",
                  "array"
                ]
              },
              "username": {
                "type": "string"
              },
              "credential": {
                "type": "string"
              }
            }
          },
          "description": "WebRTCで使うSTUN/TURNサーバーをRTCIceServer[]形式で指定します。"
        },
        "campDiff.roomPassword": {
          "type": "string",
          "default": "",
          "description": "固定開発ルームのy-webrtcアプリ層暗号化に使う任意のパスワードです。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "compile": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.webview.json --noEmit",
    "lint": "eslint src",
    "test:compile": "tsc -p tsconfig.test.json",
    "test": "npm run test:compile && vscode-test",
    "dev:signaling": "npm --prefix signaling-server run dev",
    "package": "vsce package"
  },
  "dependencies": {
    "ignore": "^7.0.8",
    "y-protocols": "1.0.6",
    "y-webrtc": "10.3.0",
    "yjs": "13.6.27"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.4.0",
    "@types/vscode": "^1.134.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  }
}
